# Server
PORT=3000

# Infra (laradock: PG 5432, Redis 6379 with password)
DATABASE_URL=postgres://default:secret@localhost:5432/montez_audit
REDIS_URL=redis://:secret_redis@localhost:6379

# Storage — Cloudflare R2 (S3-compatible). REQUIRED: the app fails to start if
# these are blank. Endpoint is the full URL, e.g.
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=audit-media
R2_PUBLIC_URL=

# Auth
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Google Sign-In (id-token flow) — OAuth Client type "Web application" dari Google
# Cloud Console. Client ID yang sama dipakai FE (NUXT_PUBLIC_GOOGLE_CLIENT_ID).
# Kosong = POST /api/auth/login/google membalas 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limit POST /audits per user
AUDIT_RATE_LIMIT=10
AUDIT_RATE_WINDOW_SEC=3600

# Scraping
TIKHUB_API_KEY=

# AI providers — Gemini (native) for video/vision, OpenRouter for all text models.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (script, sentiment, recommendations, chat). Pick a model that supports
# structured output (json_schema), e.g. openai/gpt-4o-mini or google/gemini-2.5-flash.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=montez-agent

# Transcription (OpenAI/Groq compatible)
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1


# Meta "Login with Facebook" OAuth (Instagram owner-access)
META_APP_ID=
META_APP_SECRET=
# Harus sama dengan route callback: http://localhost:3000/api/auth/facebook/callback
META_REDIRECT_URI=
META_OAUTH_SUCCESS_REDIRECT=
