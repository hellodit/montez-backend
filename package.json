{
  "name": "montez-backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/app.ts",
    "start": "bun run src/app.ts",
    "worker": "bun run --hot src/queue/runner.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "studio": "mastra studio --port 4111 --server-port 3000 --server-api-prefix /mastra"
  },
  "dependencies": {
    "@mastra/hono": "^1.5.14",
    "@mastra/pg": "^1.19.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "mastra": "^1.24.0",
    "typescript": "^5.9.3"
  }
}