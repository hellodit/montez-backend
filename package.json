{
  "name": "montez-backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/app.ts",
    "start": "bun run src/app.ts",
    "worker": "bun run --hot src/queue/runner.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "studio": "mastra studio --port 4111 --server-port 3000 --server-api-prefix /mastra"
  },
  "dependencies": {
    "@mastra/auth-better-auth": "^1.1.3",
    "@mastra/core": "^1.58.0",
    "@mastra/duckdb": "^1.6.1",
    "@mastra/hono": "^1.6.0",
    "@mastra/observability": "^1.16.6",
    "@mastra/pg": "^1.20.0",
    "@mastra/rag": "^2.4.2",
    "ai": "^7.0.31",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "mastra": "^1.24.0",
    "typescript": "^5.9.3"
  }
}